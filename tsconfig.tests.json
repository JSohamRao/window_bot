{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/main/**/*.ts", "src/renderer/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
